# Portal veritabanı (Netsis'ten AYRI). SQL Server bağlantı dizesi.
# Windows kimlik doğrulaması yerine SQL kullanıcısı önerilir.
DATABASE_URL="sqlserver://localhost:1433;database=OzguvenisPortal;user=portal_app;password=DEGISTIR;trustServerCertificate=true;encrypt=true"

# Prisma migrate için gölge veritabanı (yalnızca geliştirme; boş bir DB oluşturun)
SHADOW_DATABASE_URL="sqlserver://localhost:1433;database=OzguvenisPortal_shadow;user=portal_app;password=DEGISTIR;trustServerCertificate=true;encrypt=true"

JWT_SECRET="en-az-32-karakterlik-rastgele-bir-deger-uretin"
JWT_EXPIRES_IN="12h"          # "Beni hatırla" işaretlenmeden açılan oturum
JWT_REMEMBER_EXPIRES_IN="7d"  # "Beni hatırla": kullanıldıkça yenilenir
PORT=3000
CORS_ORIGIN="http://localhost:5173"

# İlk kurulumda seed'in oluşturacağı yönetici (ilk girişten sonra şifreyi değiştirin)
SEED_ADMIN_EMAIL="admin@ozguvenis.local"
SEED_ADMIN_PASSWORD="Degistir!12345"

# Uygulamanın dış adresi (e-posta ve push bağlantıları için)
PORTAL_URL="https://portal.sirketadi.com.tr"
# Dosya ekleri (masraf fişi, poliçe, mesaj eki); yedeklemeye dahil edin
STORAGE_DIR="C:/OzguvenisPortal/uploads"
# Mobil uygulama için CORS_ORIGIN'e ekleyin: https://localhost,capacitor://localhost

# --- Faz 2: Netsis (yalnızca okuma). Sunucu boşsa entegrasyon kapalı. Ayrıntı: docs/moduller/netsis.md
NETSIS_DB_SERVER=""
NETSIS_DB_PORT=1433
NETSIS_DB_NAME=""
NETSIS_DB_USER="netsis_ro"
NETSIS_DB_PASSWORD=""
NETSIS_DB_ENCRYPT=true
NETSIS_DB_TRUST_CERT=true
NETSIS_TURKISH_FIX=true
ERP_SYNC_MINUTES=10
ERP_SYNC_WINDOW_DAYS=365

# --- Push bildirimleri: Firebase Cloud Messaging (web, Android, iOS). Ayrıntı: docs/moduller/bildirim-mobil.md
# Sunucu: Firebase → Proje ayarları → Hizmet hesapları → Yeni özel anahtar (JSON dosyası; repoya koymayın).
FCM_PROJECT_ID=""
FCM_SERVICE_ACCOUNT_FILE=""
# Web uygulaması: Firebase → Proje ayarları → Genel → Web uygulaması (firebaseConfig) ve
# Cloud Messaging → Web Push sertifikaları → Anahtar çifti. Boşsa tarayıcı bildirimleri kapalıdır.
FCM_WEB_API_KEY=""
FCM_WEB_APP_ID=""
FCM_WEB_MESSAGING_SENDER_ID=""
FCM_WEB_VAPID_KEY=""
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASSWORD=""
MAIL_FROM="Ozguvenis Portal <portal@sirketadi.com.tr>"

# --- Faz 4: WhatsApp Business Cloud API. Ayrıntı: docs/moduller/sure-takibi-whatsapp.md
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_APP_SECRET=""
WHATSAPP_VERIFY_TOKEN=""
WHATSAPP_WABA_ID=""
WHATSAPP_API_VERSION="v21.0"
# TRACKING_REMINDERS=off   # süre takibi hatırlatma işini kapatır

# --- Faz 5: WebRTC (eşler arası) arama ve toplantı. Ayrıntı: docs/moduller/mesajlasma-toplanti.md
# İç ağda boş bırakılabilir. Mobil veri / farklı ağdan bağlanan olacaksa TURN sunucusu ekleyin:
# ICE_SERVERS='[{"urls":"stun:stun.l.google.com:19302"},{"urls":"turn:turn.sirket.com.tr:3478","username":"u","credential":"p"}]'
ICE_SERVERS=""

# --- Faz 3: TypeSafe Jev ile masraf kategorisi önerisi (varsayılan kapalı; Ayarlar'dan açılır).
# Açıldığında masraf açıklaması şirket dışındaki TypeSafe servisine gönderilir.
TYPESAFE_API_KEY=""
# TYPESAFE_MODEL="jev-latest"
