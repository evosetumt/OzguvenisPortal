# Mobil derleme (npm run build:mobile) için: .env.mobile olarak kopyalayın (gitignore'da, depoya girmez).
# Uygulama cihazda çalıştığı için API'nin dışarıdan erişilen tam adresi gerekir (sonunda / olmadan).
# REST (/api), dosyalar (/api/attachments), arama ve socket.io (/api/socket.io) hepsi bu kökü kullanır.
# Portal Cloudflare Tunnel üzerinden genel HTTPS ile yayınlanır; iç ağ IP'si veya iç sertifika KULLANMAYIN.
VITE_API_URL=https://evoflow.ozguvenis.com.tr

# Yerel (FCM/APNs) anlık bildirim: Android'de android/app/google-services.json, iOS'ta ios/App/App/GoogleService-Info.plist
# eklenmeden 1 YAPMAYIN (yapılandırma yokken PushNotifications.register() uygulamayı çökertir). Bkz. deploy/mobile/MAGAZA.md
VITE_NATIVE_PUSH=0
