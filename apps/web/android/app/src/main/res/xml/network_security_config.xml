<?xml version="1.0" encoding="utf-8"?>
<!-- Portal iç ağda kendi kök sertifikamızla (Özgüveniş iç CA) HTTPS sunar; uygulama bu köke ve sistem köklerine güvenir. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="@raw/ozguvenis_kok" />
        </trust-anchors>
    </base-config>
</network-security-config>
