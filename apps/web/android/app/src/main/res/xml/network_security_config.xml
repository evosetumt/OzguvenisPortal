<?xml version="1.0" encoding="utf-8"?>
<!--
  Portal genel internette https://evoflow.ozguvenis.com.tr adresinden (Cloudflare Tunnel, Cloudflare TLS sertifikası) yayınlanır.
  Uygulama yalnızca sistemin güvendiği kök sertifikalara güvenir; şifresiz (http) trafiğe izin verilmez.
  (Eski iç ağ kök sertifikası "ozguvenis_kok" artık kullanılmıyor.)
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
